# Telegram Bot Credentials (Get from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here
OWNER_CHAT_ID=your_telegram_numeric_chat_id

# Media Channel (Telegram channel ID where product images are stored, starts with -100)
MEDIA_CHANNEL_ID=-100xxxxxxxxxx

# Web Dashboard URL (HTTPS URL for Telegram Mini App, e.g. https://your-app.fly.dev)
WEB_URL=

# Shop Branding & Contact Information
SHOP_NAME=Amazing Shoes Addis
SHOP_PHONE=251912345678
SHOP_LOCATION=Bole, Addis Ababa
SHOP_TELEGRAM=@your_telegram_handle

# Database File Path (SQLite)
DB_PATH=./data/shop.db

# Application Configuration
PRODUCTS_PER_PAGE=10
MAX_CART_ITEMS=20

# Server Settings
NODE_ENV=development
PORT=3000
WEB_PORT=3000

# Development Mode Auth Bypass (Allows accessing admin API with x-dev-user-id header matching OWNER_CHAT_ID)
DEV_AUTH=true
